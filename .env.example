VITE_API_BASE_URL=https://portfolio-next-eight-iota.vercel.app/api
VITE_USE_STATIC_DATA=true
VITE_ARTICLES_REPO_URL=https://raw.githubusercontent.com/Abdelrahman5243/articles/main

# Analytics
# ─────────────────────────────────────────────────────────────────────────
# GTM_ID:            Google Tag Manager container ID, e.g. GTM-XXXXXXX.
#                     Configure the GA4 Configuration tag INSIDE this GTM
#                     container — do not also set VITE_GA_DIRECT below.
# GA_MEASUREMENT_ID:  GA4 property ID, e.g. G-XXXXXXXXXX.
#                     Required either way — GTM's GA4 tag reads it as a
#                     variable, or it is used directly if VITE_GA_DIRECT=true.
# CLARITY_PROJECT_ID: Microsoft Clarity project ID.
#
# Leave a value blank to disable that provider (useful for local dev).
VITE_GTM_ID=
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# Escape hatch ONLY: load GA4 directly via gtag.js when there is no GTM
# container at all. Ignored whenever VITE_GTM_ID is set, to avoid double
# page_view events. Leave unset/false in the normal GTM-managed setup.
# VITE_GA_DIRECT=false
